<!-- DateCalculator.xaml platform adaptation. The original CalendarDatePicker interaction is retained. -->
<UserControl xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="16" MaxWidth="520" HorizontalAlignment="Left">
            <ComboBox x:Name="DateCalculationOption" SelectedIndex="0" MinWidth="260">
                <ComboBoxItem Content="Difference between dates"/>
                <ComboBoxItem Content="Add or subtract days"/>
            </ComboBox>
            <TextBlock Text="From date"/>
            <CalendarDatePicker x:Name="FromDate"/>
            <StackPanel x:Name="ToDatePanel" Spacing="12"><TextBlock Text="To date"/><CalendarDatePicker x:Name="ToDate"/></StackPanel>
            <StackPanel x:Name="DurationPanel" IsVisible="False" Spacing="12">
                <ComboBox x:Name="AddSubtract" SelectedIndex="0"><ComboBoxItem Content="Add"/><ComboBoxItem Content="Subtract"/></ComboBox>
                <Grid ColumnDefinitions="*,*,*">
                    <StackPanel><TextBlock Text="Years"/><TextBox x:Name="Years" Text="0" MinWidth="80"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Months"/><TextBox x:Name="Months" Text="0" MinWidth="80"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Days"/><TextBox x:Name="Days" Text="0" MinWidth="80"/></StackPanel>
                </Grid>
            </StackPanel>
            <TextBlock x:Name="DateResult" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="TotalDays" FontSize="16" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
