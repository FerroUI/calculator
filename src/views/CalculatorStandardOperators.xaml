<!-- Adapted from upstream/calculator/src/Calculator/Views/CalculatorStandardOperators.xaml; see docs/xaml-adaptations.json. -->
<UserControl xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ControlRoot">
    <Grid x:Name="Root" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ErrorVisualStates">
                <VisualState x:Name="NoErrorLayout" />
                <VisualState x:Name="ErrorLayout">
                    <VisualState.Setters>
                        <Setter Target="PercentButton.IsEnabled" Value="False" />
                        <Setter Target="SquareRootButton.IsEnabled" Value="False" />
                        <Setter Target="XPower2Button.IsEnabled" Value="False" />
                        <Setter Target="InvertButton.IsEnabled" Value="False" />
                        <Setter Target="DivideButton.IsEnabled" Value="False" />
                        <Setter Target="MultiplyButton.IsEnabled" Value="False" />
                        <Setter Target="MinusButton.IsEnabled" Value="False" />
                        <Setter Target="PlusButton.IsEnabled" Value="False" />
                        <Setter Target="NegateButton.IsEnabled" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="DisplayControls" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="4" AutomationProperties.Name="Display controls">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Classes="calc symbol" Tag="Percent" x:Name="PercentButton" Grid.Column="0" AutomationProperties.AutomationId="percentButton" AutomationProperties.Name="Percent" Content="" />
            <Button Classes="calc" Tag="ClearEntry" x:Name="ClearEntryButton" Grid.Column="1" FontSize="16" AutomationProperties.AutomationId="clearEntryButton" AutomationProperties.Name="Clear entry" Content="CE" />
            <Button Classes="calc" Tag="Clear" x:Name="ClearButton" Grid.Column="2" FontSize="16" AutomationProperties.AutomationId="clearButton" AutomationProperties.Name="Clear" Content="C" />
            <Button Classes="calc symbol" Tag="Backspace" x:Name="BackSpaceButton" Grid.Column="3" FontSize="16" AutomationProperties.AutomationId="backSpaceButton" AutomationProperties.Name="Backspace" Content="" />
        </Grid>
        <Grid x:Name="StandardFunctions" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" AutomationProperties.Name="Standard functions">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="0" />
                <RowDefinition Height="0" />
                <RowDefinition Height="0" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button Classes="calc symbol" Tag="Invert" x:Name="InvertButton" FontSize="18" AutomationProperties.AutomationId="invertButton" AutomationProperties.Name="Reciprocal" Content="" />
            <Button Classes="calc symbol" Tag="XPower2" x:Name="XPower2Button" Grid.Column="1" FontSize="18" AutomationProperties.AutomationId="xpower2Button" AutomationProperties.Name="Square" Content="" />
            <Button Classes="calc symbol" Tag="Sqrt" x:Name="SquareRootButton" Grid.Column="2" AutomationProperties.AutomationId="squareRootButton" AutomationProperties.Name="Square root" Content="" />
        </Grid>
        <Grid x:Name="StandardOperators" Grid.Row="1" Grid.RowSpan="5" Grid.Column="5" AutomationProperties.Name="Standard operators">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Button Classes="calc symbol" Tag="Divide" x:Name="DivideButton" Grid.Row="0" AutomationProperties.AutomationId="divideButton" AutomationProperties.Name="Divide by" Content="" />
            <Button Classes="calc symbol" Tag="Multiply" x:Name="MultiplyButton" Grid.Row="1" AutomationProperties.AutomationId="multiplyButton" AutomationProperties.Name="Multiply by" Content="" />
            <Button Classes="calc symbol" Tag="Subtract" x:Name="MinusButton" Grid.Row="2" AutomationProperties.AutomationId="minusButton" AutomationProperties.Name="Minus" Content="" />
            <Button Classes="calc symbol" Tag="Add" x:Name="PlusButton" Grid.Row="3" AutomationProperties.AutomationId="plusButton" AutomationProperties.Name="Plus" Content="" />
            <Button Classes="calc symbol equals" Tag="Equals" x:Name="EqualButton" Grid.Row="4" AutomationProperties.AutomationId="equalButton" AutomationProperties.Name="Equals" Content="" />
        </Grid>
        <ContentControl x:Name="NumberPad" Grid.Row="2" Grid.RowSpan="4" Grid.Column="2" Grid.ColumnSpan="3" AutomationProperties.Name="Number pad" />
        <Button Classes="calc symbol" Tag="Negate" x:Name="NegateButton" Grid.Row="5" Grid.Column="2" FontWeight="Normal" AutomationProperties.AutomationId="negateButton" AutomationProperties.Name="Positive negative" Content="" />
    </Grid>
</UserControl>
