From d7d24f23bea40cb6e535914605a812b8d0e5b660 Mon Sep 17 00:00:00 2001
From: Wieslaw Soltes <wieslawsoltes@users.noreply.github.com>
Date: Sat, 31 Oct 2026 12:43:47 +0000
Subject: [PATCH] Fix Reveal border light position expression lifetime

RevealBorderLight creates its Offset expression as a temporary. Animation
snapshots hold live reference parameters weakly, so dropping the expression
also drops the pointer-position and SpotlightHeight property sets. After
the release batch, Offset evaluates to (0, 0, 0) and nearby Reveal borders
do not catch the pointer light.

Retain the expression in BorderResources for the connected spotlight's
lifetime, as RevealHoverLight already does. Disconnect and material-policy
resource replacement release it with the rest of the resources.

Add compositor regressions checking pointer movement for all four border
lights (normal/wide, light/dark themes), including material-policy resource
recreation. Both regressions fail before the fix with a zero Offset.

Validation: all seven media::media_tests tests pass with the fix.
---
 src/FerroUI.Controls/media/media_tests.rs   | 70 +++++++++++++++++++++
 src/FerroUI.Controls/media/reveal_lights.rs | 12 +++-
 2 files changed, 79 insertions(+), 3 deletions(-)

diff --git a/src/FerroUI.Controls/media/media_tests.rs b/src/FerroUI.Controls/media/media_tests.rs
index 7fdb50a7..e6677d93 100644
--- a/src/FerroUI.Controls/media/media_tests.rs
+++ b/src/FerroUI.Controls/media/media_tests.rs
@@ -130,6 +130,76 @@ fn the_effects_of_reveal_load() {
     }
 }
 
+fn assert_border_light_positions(services: &CompositorTestServices, position: ferroui_base::Point) {
+    use ferroui_base::rendering::composition::server::ServerSpotLight;
+    use ferroui_base::Vector3D;
+
+    // In particular, process the batch that releases temporary UI composition
+    // objects: a light that only works during creation must not pass this test.
+    services.run_jobs();
+    services.run_jobs();
+    let mut count = 0;
+    for light in services.top_level().lights().to_vec() {
+        let Some(border) = light.downcast_ref::<RevealBorderLight>() else { continue };
+        let spot = border.spot_light().expect("border light resources");
+        let expected = Vector3D::new(position.x, position.y, if border.is_wide_light() { 256.0 } else { 128.0 });
+        spot.compositor().with_server(|server| {
+            let object = server.get_object(spot.server()).expect("server light");
+            let light = object.as_any().downcast_ref::<ServerSpotLight>().expect("spot light");
+            assert_eq!(light.props().offset(), expected, "normal/wide border lights must follow the pointer, in both themes");
+        });
+        count += 1;
+    }
+    assert_eq!(count, 4);
+}
+
+#[test]
+fn reveal_border_lights_follow_pointer_after_creation_returns() {
+    use crate::mouse_test_helper::MouseTestHelper;
+    use ferroui_base::Point;
+
+    let services = CompositorTestServices::new(Size::new(400.0, 300.0));
+    let border = Border::new();
+    border.set_border_thickness(Thickness::uniform(1.0));
+    border.set_border_brush(Some(RevealBorderBrush::new().into()));
+    services.set_content(&border.clone().upcast::<Control>());
+    services.run_jobs();
+    let mouse = MouseTestHelper::new();
+    for position in [Point::new(70.0, 80.0), Point::new(210.0, 170.0)] {
+        mouse.move_(&border, position);
+        assert_border_light_positions(&services, position);
+    }
+}
+
+#[test]
+fn reveal_border_lights_follow_pointer_after_policy_recreation() {
+    use crate::mouse_test_helper::MouseTestHelper;
+    use ferroui_base::media::MaterialPolicy;
+    use ferroui_base::Point;
+
+    let services = CompositorTestServices::new(Size::new(400.0, 300.0));
+    let border = Border::new();
+    border.set_border_thickness(Thickness::uniform(1.0));
+    border.set_border_brush(Some(RevealBorderBrush::new().into()));
+    services.set_content(&border.clone().upcast::<Control>());
+    services.run_jobs();
+    let mouse = MouseTestHelper::new();
+    mouse.move_(&border, Point::new(30.0, 40.0));
+    assert_border_light_positions(&services, Point::new(30.0, 40.0));
+
+    MaterialPolicy::set_simulate_disabled_by_policy(true);
+    services.run_jobs();
+    for light in services.top_level().lights().to_vec() {
+        if let Some(border) = light.downcast_ref::<RevealBorderLight>() {
+            assert!(border.spot_light().is_none());
+        }
+    }
+    MaterialPolicy::set_simulate_disabled_by_policy(false);
+    services.run_jobs();
+    mouse.move_(&border, Point::new(180.0, 120.0));
+    assert_border_light_positions(&services, Point::new(180.0, 120.0));
+}
+
 fn template_with_fallback() -> Option<Rc<dyn crate::templates::IControlTemplate>> {
     Some(FuncControlTemplate::new(|_, scope| {
         let panel = Panel::new();
diff --git a/src/FerroUI.Controls/media/reveal_lights.rs b/src/FerroUI.Controls/media/reveal_lights.rs
index f69115de..90d60155 100644
--- a/src/FerroUI.Controls/media/reveal_lights.rs
+++ b/src/FerroUI.Controls/media/reveal_lights.rs
@@ -772,6 +772,9 @@ pub const BORDER_LIGHT_SWITCH_DURATION: Duration = Duration::from_millis(250);
 
 struct BorderResources {
     light: SpotLight,
+    // Expression snapshots hold live reference parameters weakly. Retain the
+    // expression (and thus its pointer/height sets) for the light's lifetime.
+    _offset_animation: Option<Rc<ExpressionAnimation>>,
     colors_proxy: Rc<CompositionPropertySet>,
     window_handlers: Vec<(WeakRef<TopLevel>, &'static str, RoutedEventHandlerToken)>,
 }
@@ -921,15 +924,18 @@ impl RevealBorderLight {
         colors_proxy.insert_color("OuterConeColor", Colors::WHITE);
         light.set_is_enabled(false);
 
-        if let Some(pointer) = ElementCompositionPreview::get_pointer_position_property_set(&element) {
+        let offset_animation = ElementCompositionPreview::get_pointer_position_property_set(&element).map(|pointer| {
             let offset = compositor.create_expression_animation_with("pointer.Position + Vector3(0,0,props.SpotlightHeight)");
             offset.set_reference_parameter("props", offset_props);
             offset.set_reference_parameter("pointer", pointer);
             light.start_animation("Offset", &*offset);
-        }
+            offset
+        });
 
         let window_handlers = self.hook_window_pointer_handlers(&element);
-        self.state.borrow_mut().resources = Some(BorderResources { light: light.clone(), colors_proxy, window_handlers });
+        self.state.borrow_mut().resources = Some(BorderResources {
+            light: light.clone(), _offset_animation: offset_animation, colors_proxy, window_handlers,
+        });
         self.set_composition_light(Some((*light).clone()));
     }
 

